generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum KycStatus {
  NOT_STARTED
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum PreferredLanguage {
  ar
  en
}

enum TransactionType {
  QR_PAYMENT
  SEND
  REQUEST
  REFUND
  BILL_PAYMENT
}

enum TransactionStatus {
  PENDING
  AUTHORIZED
  COMPLETED
  FAILED
  REFUNDED
  CANCELLED
}

enum LoyaltyEntryType {
  EARN
  REDEEM
  EXPIRE
  ADJUST
}

enum RefundStatus {
  REQUESTED
  APPROVED
  REJECTED
  COMPLETED
}

enum SettlementStatus {
  PENDING
  PAID
  FAILED
}

enum RiskAlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ActorType {
  CUSTOMER
  MERCHANT
  ADMIN
  SYSTEM
}

enum AdminRole {
  SUPPORT
  RISK_ANALYST
  OPERATIONS
  SUPER_ADMIN
}

enum KycSubjectType {
  CUSTOMER
  MERCHANT
}

enum QrIntentStatus {
  OPEN
  CONSUMED
  EXPIRED
}

model Customer {
  id                String    @id @default(cuid())
  fullName          String
  phone             String    @unique
  email             String?   @unique
  passwordHash      String
  kycStatus         KycStatus @default(NOT_STARTED)
  preferredLanguage PreferredLanguage @default(en)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  merchants           Merchant[]              @relation("MerchantOwner")
  transactions        Transaction[]           @relation("CustomerTransactions")
  counterpartyOf       Transaction[]           @relation("CounterpartyTransactions")
  loyaltyEntries      LoyaltyLedgerEntry[]
  riskAlerts          RiskAlert[]

  @@map("customers")
}

model Merchant {
  id             String    @id @default(cuid())
  businessName   String
  ownerCustomerId String
  owner          Customer  @relation("MerchantOwner", fields: [ownerCustomerId], references: [id])
  kycStatus      KycStatus @default(NOT_STARTED)
  category       String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  transactions Transaction[]
  settlements  Settlement[]
  offers       Offer[]
  riskAlerts   RiskAlert[]
  qrIntents    QrPaymentIntent[]

  @@map("merchants")
}

model Transaction {
  id                     String             @id @default(cuid())
  type                   TransactionType
  customerId             String
  customer               Customer           @relation("CustomerTransactions", fields: [customerId], references: [id])
  merchantId             String?
  merchant               Merchant?          @relation(fields: [merchantId], references: [id])
  counterpartyCustomerId String?
  counterpartyCustomer   Customer?          @relation("CounterpartyTransactions", fields: [counterpartyCustomerId], references: [id])
  amountMinor            Int
  currency               String             @default("EGP")
  status                 TransactionStatus  @default(PENDING)
  reference              String
  idempotencyKey         String             @unique
  providerPaymentId      String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  loyaltyEntries  LoyaltyLedgerEntry[]
  refundRequests  RefundRequest[]
  riskAlerts      RiskAlert[]

  @@index([customerId])
  @@index([merchantId])
  @@map("transactions")
}

model LoyaltyLedgerEntry {
  id            String           @id @default(cuid())
  customerId    String
  customer      Customer         @relation(fields: [customerId], references: [id])
  type          LoyaltyEntryType
  points        Int
  transactionId String?
  transaction   Transaction?     @relation(fields: [transactionId], references: [id])
  reason        String?
  createdAt     DateTime         @default(now())

  @@index([customerId])
  @@map("loyalty_ledger_entries")
}

model IdempotencyRecord {
  id           String   @id @default(cuid())
  key          String   @unique
  scope        String
  requestHash  String
  statusCode   Int?
  responseBody Json?
  createdAt    DateTime @default(now())

  @@map("idempotency_records")
}

model RefundRequest {
  id            String       @id @default(cuid())
  transactionId String
  transaction   Transaction  @relation(fields: [transactionId], references: [id])
  amountMinor   Int
  status        RefundStatus @default(REQUESTED)
  reason        String?
  requestedBy   String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@map("refund_requests")
}

model Settlement {
  id              String            @id @default(cuid())
  merchantId      String
  merchant        Merchant          @relation(fields: [merchantId], references: [id])
  periodStart     DateTime
  periodEnd       DateTime
  grossAmountMinor Int
  feeAmountMinor   Int
  netAmountMinor   Int
  status          SettlementStatus  @default(PENDING)
  createdAt       DateTime          @default(now())

  @@index([merchantId])
  @@map("settlements")
}

model Offer {
  id              String    @id @default(cuid())
  merchantId      String
  merchant        Merchant  @relation(fields: [merchantId], references: [id])
  title           String
  description     String?
  discountPercent Int?
  startsAt        DateTime?
  endsAt          DateTime?
  createdAt       DateTime  @default(now())

  @@map("offers")
}

model KycCase {
  id          String         @id @default(cuid())
  subjectType KycSubjectType
  subjectId   String
  status      KycStatus      @default(PENDING_REVIEW)
  notes       String?
  reviewedBy  String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([subjectId])
  @@map("kyc_cases")
}

model RiskAlert {
  id            String            @id @default(cuid())
  customerId    String?
  customer      Customer?         @relation(fields: [customerId], references: [id])
  merchantId    String?
  merchant      Merchant?         @relation(fields: [merchantId], references: [id])
  transactionId String?
  transaction   Transaction?      @relation(fields: [transactionId], references: [id])
  severity      RiskAlertSeverity
  reason        String
  createdAt     DateTime          @default(now())
  resolvedAt    DateTime?

  @@map("risk_alerts")
}

model AuditLogEntry {
  id         String    @id @default(cuid())
  actorType  ActorType
  actorId    String
  action     String
  targetType String
  targetId   String
  metadata   Json?
  createdAt  DateTime  @default(now())

  @@index([targetType, targetId])
  @@map("audit_log_entries")
}

model QrPaymentIntent {
  id                   String         @id @default(cuid())
  merchantId           String
  merchant             Merchant       @relation(fields: [merchantId], references: [id])
  amountMinor          Int
  reference            String
  status               QrIntentStatus @default(OPEN)
  consumedByTransactionId String?      @unique
  createdAt            DateTime       @default(now())
  expiresAt            DateTime

  @@index([merchantId])
  @@map("qr_payment_intents")
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  role         AdminRole @default(SUPPORT)
  createdAt    DateTime  @default(now())

  @@map("admin_users")
}
